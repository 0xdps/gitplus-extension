{
	"name": "gitplus",
	"displayName": "GitPlus",
	"description": "GitPlus enhances your workflow with meaningful additions: amend the latest commit, inspect file history, explore diffs, and understand how code evolved. Designed for clarity, built for real work.",
	"version": "0.2.0",
	"publisher": "0xdps-labs",
	"icon": "icons/gitplus-128.png",
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"git",
		"commit",
		"history",
		"file-history",
		"git-plus"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/0xdps/gitplus-vs-code-extension.git"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "gitplus.editCommitMessage",
				"title": "Edit Commit Message",
				"category": "GitPlus",
				"icon": "$(edit)"
			},
			{
				"command": "gitplus.postInstall",
				"title": "Post Install Page",
				"category": "GitPlus"
			},
			{
				"command": "gitplus.getVersion",
				"title": "Get Version",
				"category": "GitPlus"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.74.0",
		"@vscode/vsce": "^3.7.1",
		"ovsx": "^0.10.7",
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"simple-git": "^3.30.0"
	}
}
