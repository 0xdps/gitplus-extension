{
	"name": "gitplus",
	"displayName": "GitPlus",
	"description": "GitPlus enhances your workflow with meaningful additions: amend the latest commit, inspect file history, explore diffs, and understand how code evolved. Designed for clarity, built for real work.",
	"version": "0.2.1",
	"publisher": "0xdps-labs",
	"icon": "icons/gitplus-128.png",
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"git",
		"commit",
		"history",
		"file-history",
		"git-plus"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/0xdps/gitplus-vs-code-extension.git"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "gitplus.editCommitMessage",
				"title": "Edit Commit Message",
				"category": "GitPlus",
				"icon": "$(edit)"
			},
			{
				"command": "gitplus.showFileHistory",
				"title": "Show File History",
				"category": "GitPlus",
				"icon": "$(history)"
			},
			{
				"command": "gitplus.resolveMergeConflicts",
				"title": "Resolve Merge Conflicts (3-Way)",
				"category": "GitPlus",
				"icon": "$(git-merge)"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "gitplus.showFileHistory",
					"group": "gitplus@1",
					"when": "resourceScheme == file"
				},
				{
					"command": "gitplus.resolveMergeConflicts",
					"group": "gitplus@2",
					"when": "resourceScheme == file"
				}
			],
			"editor/context": [
				{
					"command": "gitplus.showFileHistory",
					"group": "gitplus@1"
				},
				{
					"command": "gitplus.resolveMergeConflicts",
					"group": "gitplus@2"
				}
			],
			"commandPalette": [
				{
					"command": "gitplus.resolveMergeConflicts",
					"when": "gitOpenRepositoryCount > 0"
				}
			]
		},
		"keybindings": [
			{
				"command": "gitplus.resolveMergeConflicts",
				"key": "ctrl+shift+m",
				"mac": "cmd+shift+m",
				"when": "editorTextFocus"
			}
		]
	},
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"vscode:prepublish": "npm run compile",
		"prepare:dist": "shx mkdir -p dist",
		"package:vsix": "npm run prepare:dist && vsce package -o dist",
		"publish:vscode": "vsce publish --packagePath $(node scripts/latestVsix.js)",
		"publish:ovsx": "ovsx publish $(node scripts/latestVsix.js)",
		"release": "npm run package:vsix && npm run publish:vscode && npm run publish:ovsx"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.74.0",
		"@vscode/vsce": "^3.7.1",
		"ovsx": "^0.10.7",
		"shx": "^0.4.0",
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"simple-git": "^3.30.0"
	}
}
